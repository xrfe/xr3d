# Copy to .env. Never commit real credentials.
# python -m backend.serve generates XR3D_API_TOKEN if missing.
XR3D_API_TOKEN=
XR3D_DATA_DIR=backend-data
XR3D_JOB_TIMEOUT_SECONDS=3600
XR3D_MAX_PENDING_JOBS=8

# Hosted TRELLIS.2: credentials remain on this server.
FAL_KEY=
FAL_TRELLIS_MODEL=fal-ai/trellis-2

# Optional shared Meshy credential. Users can instead choose My Meshy key in Android.
MESHY_API_KEY=
MESHY_MODEL=meshy-7.1

# Local inference: install upstream TRELLIS.2 in its own CUDA environment.
# JSON argv; use absolute paths valid on the server. No shell expansion.
XR3D_LOCAL_COMMAND=
XR3D_LOCAL_PROVIDER=TRELLIS_2

# Optional FDM slicing: path to prusa-slicer (Linux) or prusa-slicer-console.exe (Windows).
XR3D_SLICER_EXECUTABLE=
XR3D_SLICER_PROFILE=

# Override the CalculiX solver located by Install XR3D Server or on PATH.
XR3D_CCX_EXECUTABLE=

# Bambu LAN bridge: directory containing owner-verified SERIAL.pem certificates.
# FLASHFORGE Adventurer 5M uses its own authenticated LAN HTTP API (port 8898).
XR3D_BAMBU_CERT_DIR=printer-certs

# Expire jobs left waiting for source images after 15 minutes.
XR3D_UPLOAD_TTL_SECONDS=900
